{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "framework": null,
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/dinner",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dinner",
      "destination": "/index.html"
    },
    {
      "source": "/dinner/",
      "destination": "/index.html"
    }
  ]
}