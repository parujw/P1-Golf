rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // เปิดให้ทุกคนที่มีลิงก์ดูและกรอกสกอร์ได้ (ไม่ต้องล็อกอิน)
    // จำกัดเฉพาะ collection ที่ระบบใช้ และขนาดเอกสาร
    match /event/{doc} {
      allow read: if true;
      allow write: if doc in ['config', 'roster'];
    }
    match /scores/{pid} {
      allow read: if true;
      allow write: if request.resource.data.s is list && request.resource.data.s.size() <= 18;
    }
    match /ntp/{hole} {
      allow read: if true;
      allow write: if request.resource.data.entries is list && request.resource.data.entries.size() <= 60;
    }
  }
}
