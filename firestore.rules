rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ทุกคนที่มีลิงก์ดูและแก้ไขได้ (ไม่ต้องล็อกอิน)
    // จำกัดเฉพาะข้อมูลที่ระบบใช้ และขนาดเอกสาร

    match /event/{doc} {
      allow read: if true;
      allow write: if doc in ['config', 'roster'];
    }

    match /scores/{pid} {
      allow read: if true;
      allow write: if request.resource.data.s is list
                   && request.resource.data.s.size() <= 18;
    }

    match /ntp/{hole} {
      allow read: if true;
      allow write: if request.resource.data.entries is list
                   && request.resource.data.entries.size() <= 60;
    }

    // รูปผู้บริหาร (ย่อเหลือ ~320px)
    match /photos/{pid} {
      allow read: if true;
      allow write: if request.resource.data.img is string
                   && request.resource.data.img.size() < 400000;
    }

    // สไลด์ PR: รูปรับรางวัล + ชื่อรางวัล
    match /pr/{id} {
      allow read: if true;
      allow write: if request.resource.data.img is string
                   && request.resource.data.img.size() < 950000
                   && request.resource.data.title is string
                   && request.resource.data.title.size() < 200;
    }
  }
}
